{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["client_entity", "entity_type_category", "nodes", "edges", "cycles", "conflicts", "deduplication_log"],
  "properties": {
    "client_entity": { "type": "string" },
    "entity_type_category": {
      "type": "string",
      "enum": [
        "Category 1 - Private/Regulated/Listed",
        "Category 2 - Adverse Media",
        "Category 3 - SPV/Trust/Charity/Foundation",
        "Entity Type not confirmed"
      ]
    },
    "nodes": {
      "type": "array",
      "description": "Unified list of all deduplicated ownership nodes across all documents.",
      "items": {
        "type": "object",
        "required": ["id", "name", "normalizedName", "dedupKey", "asciiDedupKey", "type", "layer", "listing_proof", "data_gaps", "exceptions"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Canonical dedupKey from Wave 2, used as the stable node identifier."
          },
          "name": { "type": "string", "description": "Most complete legal name found across all input documents." },
          "normalizedName": { "type": "string" },
          "dedupKey": { "type": "string" },
          "asciiDedupKey": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "Listed Company", "Private Company", "Regulated Entity",
              "Natural Person", "SPV", "Trust", "Charity", "Foundation",
              "Partnership", "Government Entity", "Branch", "Unknown"
            ]
          },
          "layer": { "type": "integer", "minimum": 0 },
          "listing_proof": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["exchange", "ticker", "isin", "proof_source"],
                "properties": {
                  "exchange": { "type": "string" },
                  "ticker": { "type": "string" },
                  "isin": { "type": "string" },
                  "proof_source": { "type": "string" }
                }
              }
            ]
          },
          "data_gaps": { "type": "string" },
          "exceptions": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "description": "Deduplicated ownership edges. owner and owned reference canonical dedupKey values.",
      "items": {
        "type": "object",
        "required": ["owner", "owned", "ownership_percentage_direct", "control", "source"],
        "properties": {
          "owner": { "type": "string", "description": "Canonical dedupKey of the owning entity." },
          "owned": { "type": "string", "description": "Canonical dedupKey of the owned entity." },
          "ownership_percentage_direct": {
            "type": "string",
            "description": "Exact % if consistent, 'Not Available' if missing, or 'CONFLICT — see conflicts array' if disputed."
          },
          "control": { "type": "string" },
          "source": { "type": "string", "description": "Comma-separated list of all source documents." }
        }
      }
    },
    "cycles": {
      "type": "array",
      "description": "All cycles detected across W1 and W3.",
      "items": {
        "type": "object",
        "required": ["cycle_path", "detected_at", "source"],
        "properties": {
          "cycle_path": { "type": "array", "items": { "type": "string" } },
          "detected_at": { "type": "string", "enum": ["W1", "W3"] },
          "source": { "type": "string" }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "description": "All ownership % conflicts. Keyed on (owner, owned) edge. Never resolved — preserved for audit.",
      "items": {
        "type": "object",
        "required": ["owner", "owned", "conflict_description", "value_a", "source_a", "value_b", "source_b", "resolution_strategy", "resolved_value"],
        "properties": {
          "owner": { "type": "string" },
          "owned": { "type": "string" },
          "conflict_description": { "type": "string" },
          "value_a": { "type": "string" },
          "source_a": { "type": "string" },
          "value_b": { "type": "string" },
          "source_b": { "type": "string" },
          "resolution_strategy": {
            "type": "string",
            "enum": ["use_higher", "use_lower", "use_most_recent", "manual"]
          },
          "resolved_value": { "type": "string" }
        }
      }
    },
    "deduplication_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["canonical_id", "merged_keys", "merged_names", "reason"],
        "properties": {
          "canonical_id": { "type": "string" },
          "merged_keys": { "type": "array", "items": { "type": "string" } },
          "merged_names": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
