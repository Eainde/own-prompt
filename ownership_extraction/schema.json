{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["source_document", "nodes", "edges", "cycles", "conflicts"],
  "properties": {
    "source_document": {
      "type": "string",
      "description": "GCS path or document name this flat ownership graph was extracted from."
    },
    "nodes": {
      "type": "array",
      "description": "Every entity found in the document. No target, no layer, no ownership_chain — grounding is a downstream agent.",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "entity_type_category", "listing_proof", "data_gaps", "exceptions", "classification_reasoning"],
        "properties": {
          "id": { "type": "string", "description": "Slug: lowercase name, spaces to underscores." },
          "name": { "type": "string", "description": "Legal name exactly as stated in the document." },
          "type": {
            "type": "string",
            "enum": ["Listed Company", "Private Company", "Regulated Entity", "Natural Person", "SPV", "Trust", "Charity", "Foundation", "Partnership", "Government Entity", "Branch", "Unknown"]
          },
          "entity_type_category": {
            "type": "string",
            "enum": ["Category 1 - Private/Regulated/Listed", "Category 2 - Adverse Media", "Category 3 - SPV/Trust/Charity/Foundation", "Entity Type not confirmed"],
            "description": "Per-node KYC category. Drives what to extract for this entity (e.g. Cat 3 SPV/Trust roles)."
          },
          "listing_proof": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["exchange", "ticker", "isin", "proof_source"],
                "properties": {
                  "exchange": { "type": "string" },
                  "ticker": { "type": "string" },
                  "isin": { "type": "string" },
                  "proof_source": { "type": "string" }
                }
              }
            ]
          },
          "data_gaps": { "type": "string" },
          "exceptions": { "type": "string" },
          "classification_reasoning": {
            "type": "string",
            "description": "Entity type reasoning + the document page/section that evidences this entity. No owner/subsidiary/layer claims (grounding does that)."
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "description": "Every ownership relationship found, in whatever direction the document shows. No upward-only filtering.",
      "items": {
        "type": "object",
        "required": ["owner", "owned", "ownership_percentage_direct", "control", "source", "source_type", "direction_proof"],
        "properties": {
          "owner": { "type": "string", "description": "id of the entity that holds the stake." },
          "owned": { "type": "string", "description": "id of the entity whose stake is held." },
          "ownership_percentage_direct": { "type": "string", "description": "Exact % as stated, or 'Not Available', or 'CONFLICT — see conflicts array'." },
          "control": { "type": "string" },
          "source": { "type": "string", "description": "Document name + page/section." },
          "source_type": {
            "type": "string",
            "enum": ["chart_structure", "document_text"],
            "description": "Provenance: derived from the Chart Reader artifact, or read from non-chart document text."
          },
          "direction_proof": {
            "type": "string",
            "description": "For chart_structure edges: 'From chart_structure arrow: <evidence>'. For document_text edges: the page/section text proving direction."
          }
        }
      }
    },
    "cycles": {
      "type": "array",
      "description": "Structural cycles detected by DFS over the flat directed edge graph.",
      "items": {
        "type": "object",
        "required": ["cycle_path", "detected_at", "source"],
        "properties": {
          "cycle_path": { "type": "array", "items": { "type": "string" } },
          "detected_at": { "type": "string", "enum": ["W1", "W3"] },
          "source": { "type": "string" }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "description": "Within-document % conflicts (e.g. chart vs text). Resolution is deferred to Agent 4.",
      "items": {
        "type": "object",
        "required": ["owner", "owned", "conflict_description", "value_a", "source_a", "value_b", "source_b", "resolution_strategy", "resolved_value"],
        "properties": {
          "owner": { "type": "string" },
          "owned": { "type": "string" },
          "conflict_description": { "type": "string" },
          "value_a": { "type": "string" },
          "source_a": { "type": "string" },
          "value_b": { "type": "string" },
          "source_b": { "type": "string" },
          "resolution_strategy": { "type": "string", "enum": ["use_higher", "use_lower", "use_most_recent", "manual", "deferred"] },
          "resolved_value": { "type": "string" }
        }
      }
    }
  }
}
