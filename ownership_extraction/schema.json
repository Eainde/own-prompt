{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["client_entity", "entity_type_category", "source_document", "nodes", "conflicts"],
  "properties": {
    "client_entity": {
      "type": "string",
      "description": "Legal name of the target entity (Layer 0)"
    },
    "entity_type_category": {
      "type": "string",
      "enum": [
        "Category 1 - Private/Regulated/Listed",
        "Category 2 - Adverse Media",
        "Category 3 - SPV/Trust/Charity/Foundation",
        "Entity Type not confirmed"
      ]
    },
    "source_document": {
      "type": "string",
      "description": "GCS path or document name this chart was extracted from"
    },
    "nodes": {
      "type": "array",
      "description": "All ownership nodes extracted from this document",
      "items": {
        "type": "object",
        "required": [
          "id",
          "parent_id",
          "name",
          "type",
          "layer",
          "ownership_percentage_direct",
          "control",
          "source",
          "listing_proof",
          "data_gaps",
          "exceptions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Slug: lowercase entity name with spaces replaced by underscores. E.g. deutsche_bank_ag"
          },
          "parent_id": {
            "type": "string",
            "description": "id of the parent node. null if this is the root (top parent with no further owner)"
          },
          "name": {
            "type": "string",
            "description": "Legal name exactly as stated in the document"
          },
          "type": {
            "type": "string",
            "enum": [
              "Listed Company",
              "Private Company",
              "Regulated Entity",
              "Natural Person",
              "SPV",
              "Trust",
              "Charity",
              "Foundation",
              "Partnership",
              "Government Entity",
              "Branch",
              "Unknown"
            ]
          },
          "layer": {
            "type": "integer",
            "minimum": 0,
            "description": "0 = Client, 1 = direct owners, 2 = owners of layer 1, etc."
          },
          "ownership_percentage_direct": {
            "type": "string",
            "description": "Exact % as stated in the document, or 'Not Available' if missing. Never infer."
          },
          "control": {
            "type": "string",
            "description": "Evidence of control (voting rights, board rights, etc.) or null if not evidenced"
          },
          "source": {
            "type": "string",
            "description": "Exact document name and page/section reference where this relationship is evidenced"
          },
          "listing_proof": {
            "description": "Populated only for Listed Company type. null for all other entity types.",
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["exchange", "ticker", "isin", "proof_source"],
                "properties": {
                  "exchange": { "type": "string" },
                  "ticker": { "type": "string" },
                  "isin": { "type": "string" },
                  "proof_source": {
                    "type": "string",
                    "description": "Document and page where listing is evidenced"
                  }
                }
              }
            ]
          },
          "data_gaps": {
            "type": "string",
            "description": "Description of missing or incomplete data for this node, or null"
          },
          "exceptions": {
            "type": "string",
            "description": "Any anomalies, conflicts within this node, or null"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "description": "Ownership % conflicts found within this document",
      "items": {
        "type": "object",
        "required": ["entity_id", "conflict_description", "value_a", "source_a", "value_b", "source_b"],
        "properties": {
          "entity_id": { "type": "string" },
          "conflict_description": { "type": "string" },
          "value_a": { "type": "string" },
          "source_a": { "type": "string" },
          "value_b": { "type": "string" },
          "source_b": { "type": "string" }
        }
      }
    }
  }
}
