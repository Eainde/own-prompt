{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Wave 4 org chart tree output. Schema version v0.",
  "type": "object",
  "required": ["client_entity", "entity_type_category", "ownership_tree", "cycles", "conflicts", "metadata"],
  "properties": {
    "client_entity": { "type": "string" },
    "entity_type_category": {
      "type": "string",
      "enum": [
        "Category 1 - Private/Regulated/Listed",
        "Category 2 - Adverse Media",
        "Category 3 - SPV/Trust/Charity/Foundation",
        "Entity Type not confirmed"
      ]
    },
    "ownership_tree": {
      "$ref": "#/definitions/tree_node",
      "description": "Root node (client entity). All owners nested recursively as children."
    },
    "cycles": {
      "type": "array",
      "description": "All cycles carried forward from Wave 3. Not modified.",
      "items": {
        "type": "object",
        "required": ["cycle_path", "detected_at", "source"],
        "properties": {
          "cycle_path": { "type": "array", "items": { "type": "string" } },
          "detected_at": { "type": "string", "enum": ["W1", "W3"] },
          "source": { "type": "string" }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "description": "All conflicts carried forward from Wave 3. Not resolved.",
      "items": {
        "type": "object",
        "required": ["owner", "owned", "conflict_description", "value_a", "source_a", "value_b", "source_b", "resolution_strategy", "resolved_value"],
        "properties": {
          "owner": { "type": "string" },
          "owned": { "type": "string" },
          "conflict_description": { "type": "string" },
          "value_a": { "type": "string" },
          "source_a": { "type": "string" },
          "value_b": { "type": "string" },
          "source_b": { "type": "string" },
          "resolution_strategy": {
            "type": "string",
            "enum": ["use_higher", "use_lower", "use_most_recent", "manual"]
          },
          "resolved_value": { "type": "string" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["schema_version", "note"],
      "properties": {
        "schema_version": { "type": "string", "enum": ["v0"] },
        "note": { "type": "string" }
      }
    }
  },
  "definitions": {
    "tree_node": {
      "type": "object",
      "required": ["id", "name", "type", "layer", "ownership_percentage_direct", "control", "source", "listing_proof", "data_gaps", "exceptions", "children"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "Listed Company", "Private Company", "Regulated Entity",
            "Natural Person", "SPV", "Trust", "Charity", "Foundation",
            "Partnership", "Government Entity", "Branch", "Unknown"
          ]
        },
        "layer": { "type": "integer", "minimum": 0 },
        "ownership_percentage_direct": {
          "type": "string",
          "description": "From the edge linking this node to its parent in this subtree. null for the root node."
        },
        "control": { "type": "string" },
        "source": { "type": "string" },
        "listing_proof": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["exchange", "ticker", "isin", "proof_source"],
              "properties": {
                "exchange": { "type": "string" },
                "ticker": { "type": "string" },
                "isin": { "type": "string" },
                "proof_source": { "type": "string" }
              }
            }
          ]
        },
        "data_gaps": { "type": "string" },
        "exceptions": { "type": "string" },
        "children": {
          "type": "array",
          "description": "Direct owners of this node. Each child carries ownership_percentage_direct from the edge linking it to this node.",
          "items": { "$ref": "#/definitions/tree_node" }
        }
      }
    }
  }
}
