{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["nodes", "edges", "overlaps", "potential_conflicts", "cycles", "conflicts"],
  "properties": {
    "nodes": {
      "type": "array",
      "description": "All ownership nodes across all input documents, preserved as-is with namespaced ids. Nothing is merged or eliminated.",
      "items": {
        "type": "object",
        "required": ["id", "source_document", "name", "normalizedName", "dedupKey", "asciiDedupKey", "type", "entity_type_category", "listing_proof", "data_gaps", "exceptions", "classification_reasoning"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Namespaced <source_doc_id>::<slug>, globally unique; nothing merged."
          },
          "source_document": {
            "type": "string",
            "description": "GCS URI of the source document this node originates from."
          },
          "name": { "type": "string" },
          "normalizedName": { "type": "string" },
          "dedupKey": { "type": "string" },
          "asciiDedupKey": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "Listed Company", "Private Company", "Regulated Entity",
              "Natural Person", "SPV", "Trust", "Charity", "Foundation",
              "Partnership", "Government Entity", "Branch", "Unknown"
            ]
          },
          "entity_type_category": {
            "type": "string",
            "enum": [
              "Category 1 - Private/Regulated/Listed",
              "Category 2 - Adverse Media",
              "Category 3 - SPV/Trust/Charity/Foundation",
              "Entity Type not confirmed"
            ]
          },
          "listing_proof": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["exchange", "ticker", "isin", "proof_source"],
                "properties": {
                  "exchange": { "type": "string" },
                  "ticker": { "type": "string" },
                  "isin": { "type": "string" },
                  "proof_source": { "type": "string" }
                }
              }
            ]
          },
          "data_gaps": { "type": "string" },
          "exceptions": { "type": "string" },
          "classification_reasoning": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "description": "All ownership edges across all input documents, preserved with namespaced owner/owned ids. Nothing is merged or eliminated.",
      "items": {
        "type": "object",
        "required": ["owner", "owned", "ownership_percentage_direct", "control", "source", "source_document", "source_type", "direction_proof"],
        "properties": {
          "owner": { "type": "string", "description": "Namespaced id of the owning entity." },
          "owned": { "type": "string", "description": "Namespaced id of the owned entity." },
          "ownership_percentage_direct": { "type": "string" },
          "control": { "type": "string" },
          "source": { "type": "string" },
          "source_document": {
            "type": "string",
            "description": "GCS URI of the source document this edge originates from."
          },
          "source_type": {
            "type": "string",
            "enum": ["chart_structure", "document_text"]
          },
          "direction_proof": { "type": "string" }
        }
      }
    },
    "overlaps": {
      "type": "array",
      "description": "Candidate same-entity groups across documents. Nothing is merged — these are hints for Agent 4.",
      "items": {
        "type": "object",
        "required": ["dedup_key", "member_ids", "match_basis", "confidence_note"],
        "properties": {
          "dedup_key": { "type": "string" },
          "member_ids": { "type": "array", "items": { "type": "string" } },
          "match_basis": { "type": "string", "enum": ["dedupKey", "asciiDedupKey", "similarity"] },
          "confidence_note": { "type": "string" }
        }
      }
    },
    "potential_conflicts": {
      "type": "array",
      "description": "Cross-document % disagreements between overlapping relationships. Detection only — Agent 4 resolves.",
      "items": {
        "type": "object",
        "required": ["owner_overlap", "owned_overlap", "values", "sources", "status"],
        "properties": {
          "owner_overlap": { "type": "string" },
          "owned_overlap": { "type": "string" },
          "values": { "type": "array", "items": { "type": "string" } },
          "sources": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["agree", "contradict"] }
        }
      }
    },
    "cycles": {
      "type": "array",
      "description": "All cycles detected upstream (W1 or W3), carried forward unresolved.",
      "items": {
        "type": "object",
        "required": ["cycle_path", "detected_at", "source"],
        "properties": {
          "cycle_path": { "type": "array", "items": { "type": "string" } },
          "detected_at": { "type": "string", "enum": ["W1", "W3"] },
          "source": { "type": "string" }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "description": "Ownership % conflicts carried forward from upstream waves, unresolved. Resolution is deferred to Agent 4; resolution_strategy may be 'deferred' to indicate no resolution has been applied.",
      "items": {
        "type": "object",
        "required": ["owner", "owned", "conflict_description", "value_a", "source_a", "value_b", "source_b", "resolution_strategy", "resolved_value"],
        "properties": {
          "owner": { "type": "string" },
          "owned": { "type": "string" },
          "conflict_description": { "type": "string" },
          "value_a": { "type": "string" },
          "source_a": { "type": "string" },
          "value_b": { "type": "string" },
          "source_b": { "type": "string" },
          "resolution_strategy": {
            "type": "string",
            "enum": ["use_higher", "use_lower", "use_most_recent", "manual", "deferred"]
          },
          "resolved_value": { "type": "string" }
        }
      }
    }
  }
}
