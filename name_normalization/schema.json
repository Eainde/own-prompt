{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["normalized_documents"],
  "properties": {
    "normalized_documents": {
      "type": "array",
      "description": "One entry per Wave 1 input document. Nodes enriched with normalization fields. Edges carried forward unchanged.",
      "items": {
        "type": "object",
        "required": ["client_entity", "entity_type_category", "source_document", "nodes", "edges", "cycles", "conflicts"],
        "properties": {
          "client_entity": { "type": "string" },
          "entity_type_category": {
            "type": "string",
            "enum": [
              "Category 1 - Private/Regulated/Listed",
              "Category 2 - Adverse Media",
              "Category 3 - SPV/Trust/Charity/Foundation",
              "Entity Type not confirmed"
            ]
          },
          "source_document": { "type": "string" },
          "nodes": {
            "type": "array",
            "items": { "$ref": "#/definitions/normalized_node" }
          },
          "edges": {
            "type": "array",
            "description": "Ownership edges carried forward unchanged from Wave 1.",
            "items": {
              "type": "object",
              "required": ["owner", "owned", "ownership_percentage_direct", "control", "source", "direction_proof"],
              "properties": {
                "owner": { "type": "string" },
                "owned": { "type": "string" },
                "ownership_percentage_direct": { "type": "string" },
                "control": { "type": "string" },
                "source": { "type": "string" },
                "direction_proof": { "type": "string", "description": "Direction proof from Wave 1. Carried forward unchanged." }
              }
            }
          },
          "cycles": {
            "type": "array",
            "description": "Cycles carried forward from Wave 1.",
            "items": {
              "type": "object",
              "required": ["cycle_path", "detected_at", "source"],
              "properties": {
                "cycle_path": { "type": "array", "items": { "type": "string" } },
                "detected_at": { "type": "string", "enum": ["W1", "W3"] },
                "source": { "type": "string" }
              }
            }
          },
          "conflicts": {
            "type": "array",
            "description": "Conflicts carried forward unchanged from Wave 1.",
            "items": {
              "type": "object",
              "required": ["owner", "owned", "conflict_description", "value_a", "source_a", "value_b", "source_b", "resolution_strategy", "resolved_value"],
              "properties": {
                "owner": { "type": "string" },
                "owned": { "type": "string" },
                "conflict_description": { "type": "string" },
                "value_a": { "type": "string" },
                "source_a": { "type": "string" },
                "value_b": { "type": "string" },
                "source_b": { "type": "string" },
                "resolution_strategy": {
                  "type": "string",
                  "enum": ["use_higher", "use_lower", "use_most_recent", "manual"]
                },
                "resolved_value": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "normalized_node": {
      "type": "object",
      "required": [
        "id", "name", "type", "layer", "ownership_chain",
        "listing_proof", "data_gaps", "exceptions",
        "normalizedName", "dedupKey", "asciiDedupKey", "normalizationNote",
        "classification_reasoning"
      ],
      "properties": {
        "id": { "type": "string", "description": "Original Wave 1 slug id. Unchanged." },
        "name": { "type": "string", "description": "Legal name exactly as extracted in Wave 1. Never modified." },
        "type": {
          "type": "string",
          "enum": [
            "Listed Company", "Private Company", "Regulated Entity",
            "Natural Person", "SPV", "Trust", "Charity", "Foundation",
            "Partnership", "Government Entity", "Branch", "Unknown"
          ]
        },
        "layer": { "type": "integer", "minimum": 0 },
        "ownership_chain": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Full path of entity ids from the target entity (layer 0) to this node. Carried forward unchanged from Wave 1."
        },
        "listing_proof": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["exchange", "ticker", "isin", "proof_source"],
              "properties": {
                "exchange": { "type": "string" },
                "ticker": { "type": "string" },
                "isin": { "type": "string" },
                "proof_source": { "type": "string" }
              }
            }
          ]
        },
        "data_gaps": { "type": "string" },
        "exceptions": { "type": "string" },
        "normalizedName": { "type": "string" },
        "dedupKey": { "type": "string" },
        "asciiDedupKey": { "type": "string" },
        "normalizationNote": { "type": "string" },
        "firstName": { "type": "string" },
        "middleName": { "type": "string" },
        "lastName": { "type": "string" },
        "personalTitle": { "type": "string" },
        "classification_reasoning": {
          "type": "string",
          "description": "Full classification trace from Wave 1. Carried forward unchanged."
        }
      }
    }
  }
}
